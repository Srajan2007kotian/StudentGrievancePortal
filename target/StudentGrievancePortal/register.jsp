<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>Register</title><link rel="stylesheet" href="css/style.css"></head><body><div class="auth"><div class="brand">🎓 Student Grievance Portal</div><div class="card"><h1>Create Student Account</h1><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><form method="post" action="register"><label>Full Name</label><input name="name" required><label>Email</label><input name="email" type="email" required><label>Password</label><input name="password" type="password" minlength="6" required><button>Register</button></form><p class="center"><a href="login.jsp">Back to login</a></p></div></div></body></html>