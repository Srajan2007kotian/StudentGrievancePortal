<%@ page import="java.util.*" %><%@ page import="com.college.grievance.model.*" %><%@ page contentType="text/html;charset=UTF-8" %><%User u=(User)session.getAttribute("user");List<Complaint> cs=(List<Complaint>)request.getAttribute("complaints");%><!doctype html><html><head><title>Admin Dashboard</title><link rel="stylesheet" href="css/style.css"></head><body><nav><b>🛠 Admin · Grievance Portal</b><span><%=u.name%> · <a href="logout">Logout</a></span></nav><main><div class="hero"><div><h1>Admin Dashboard</h1><p>Monitor, search and resolve student complaints.</p></div></div><div class="stats"><div><small>Total</small><strong><%=request.getAttribute("total")%></strong></div><div><small>Pending</small><strong><%=request.getAttribute("pending")%></strong></div><div><small>In Progress</small><strong><%=request.getAttribute("progress")%></strong></div><div><small>Resolved</small><strong><%=request.getAttribute("resolved")%></strong></div></div><section class="card wide"><form class="filters" method="get" action="admin"><input name="search" value="<%=request.getParameter("search")==null?"":request.getParameter("search")%>" placeholder="Search ID, student, category..."><select name="status"><option value="">All Status</option><option>Pending</option><option>In Progress</option><option>Resolved</option></select><button>Filter</button></form><div class="tablewrap"><table><tr><th>ID</th><th>Student</th><th>Category</th><th>Issue</th><th>Status</th><th>Update</th></tr><%for(Complaint c:cs){%><tr><td><a href="complaint-details?id=<%=c.id%>"><b><%=c.code%></b></a><br><small><%=c.createdAt%></small></td><td><%=c.studentName%><br><small><%=c.studentEmail%></small></td><td><%=c.category%><br><small><%=c.location%></small></td><td><%=c.description%></td><td><span class="pill <%=c.status.replace(" ","").toLowerCase()%>"><%=c.status%></span></td><td><form method="post" action="status"><input type="hidden" name="id" value="<%=c.id%>"><select name="status"><option <%=c.status.equals("Pending")?"selected":""%>>Pending</option><option <%=c.status.equals("In Progress")?"selected":""%>>In Progress</option><option <%=c.status.equals("Resolved")?"selected":""%>>Resolved</option></select><input name="remark" value="<%=c.remark==null?"":c.remark%>" placeholder="Admin remark"><button>Save</button></form></td></tr><%}%></table></div></section></main></body></html>