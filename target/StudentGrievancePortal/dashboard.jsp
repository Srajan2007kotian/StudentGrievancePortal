<%@ page import="java.util.*" %><%@ page import="com.college.grievance.model.*" %><%@ page contentType="text/html;charset=UTF-8" %><%User u=(User)session.getAttribute("user"); List<Complaint> cs=(List<Complaint>)request.getAttribute("complaints"); int pending=0,resolved=0;for(Complaint c:cs){if("Pending".equals(c.status)||"In Progress".equals(c.status))pending++;if("Resolved".equals(c.status))resolved++;}%><!doctype html><html><head><title>Student Dashboard</title><link rel="stylesheet" href="css/style.css"></head><body><nav><b>🎓 Grievance Portal</b><span>Hi, <%=u.name%> · <a href="logout">Logout</a></span></nav><main><div class="hero"><div><h1>Student Dashboard</h1><p>Raise a complaint and track its progress.</p></div><a class="button" href="raise-complaint.jsp">+ Raise Complaint</a></div><div class="stats"><div><small>Total</small><strong><%=cs.size()%></strong></div><div><small>Active</small><strong><%=pending%></strong></div><div><small>Resolved</small><strong><%=resolved%></strong></div></div><section class="card wide"><h2>My Complaints</h2><div class="tablewrap"><table><tr><th>ID</th><th>Category</th><th>Location</th><th>Status</th><th>Date</th><th>Admin Remark</th></tr><%for(Complaint c:cs){%><tr><td><a href="complaint-details?id=<%=c.id%>"><b><%=c.code%></b></a></td><td><%=c.category%></td><td><%=c.location%></td><td><span class="pill <%=c.status.replace(" ","").toLowerCase()%>"><%=c.status%></span></td><td><%=c.createdAt%></td><td><%=c.remark==null||c.remark.isBlank()?"—":c.remark%></td></tr><%}%></table></div></section></main></body></html>