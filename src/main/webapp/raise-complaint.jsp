<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>Raise Complaint</title><link rel="stylesheet" href="css/style.css"></head><body><nav><b>🎓 Grievance Portal</b><a href="dashboard">Dashboard</a></nav><main><div class="card formcard"><h1>Raise a Complaint</h1><p class="muted">Give clear details so the college team can respond faster.</p><form method="post" action="complaint"><label>Category</label><select name="category" required><option value="">Select category</option><option>Computer Lab</option><option>Classroom</option><option>Library</option><option>Wi-Fi / Internet</option><option>Cleanliness</option><option>Faculty / Teaching</option><option>Other</option></select><label>Location</label><input name="location" placeholder="e.g. Block A, Room 204" required><label>Description</label><textarea name="description" rows="7" placeholder="Describe the issue..." required minlength="10"></textarea><button>Submit Complaint</button></form></div></main></body></html>